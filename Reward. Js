/* =====================================================
   BACK BUTTON
===================================================== */

const rewardsBack =
    document.getElementById("rewardsBack");

if(rewardsBack){

    rewardsBack.addEventListener("click", () => {

        if(window.history.length > 1){

            window.history.back();

        }else{

            window.location.href = "index.html";

        }

    });

}


/* =====================================================
   COINS
===================================================== */

let coins = 12850;

const coinBalance =
    document.getElementById("coinBalance");

const heroCoinBalance =
    document.getElementById("heroCoinBalance");


function updateCoins(){

    const formatted =
        coins.toLocaleString();

    if(coinBalance){
        coinBalance.textContent = formatted;
    }

    if(heroCoinBalance){
        heroCoinBalance.textContent = formatted;
    }

}


/* =====================================================
   ADD COINS
===================================================== */

const coinAdd =
    document.getElementById("coinAdd");

if(coinAdd){

    coinAdd.addEventListener("click", () => {

        /*
           Kwa sasa demo tu.
           Baadaye tunaweza kuunganisha
           payment system hapa.
        */

        coins += 500;

        updateCoins();

        coinAdd.animate(
            [
                {
                    transform:"scale(1)"
                },
                {
                    transform:"scale(1.25)"
                },
                {
                    transform:"scale(1)"
                }
            ],
            {
                duration:350
            }
        );

    });

}


/* =====================================================
   REWARD NAVIGATION
===================================================== */

const rewardNavs =
    document.querySelectorAll(".reward-nav");

rewardNavs.forEach(nav => {

    nav.addEventListener("click", () => {

        rewardNavs.forEach(item => {

            item.classList.remove("active");

        });

        nav.classList.add("active");

    });

});


/* =====================================================
   CLAIM REWARD
===================================================== */

const claimButtons =
    document.querySelectorAll(".claim-btn");

claimButtons.forEach(button => {

    button.addEventListener("click", () => {

        const card =
            button.closest(".reward-card");

        const priceElement =
            card.querySelector(".reward-price strong");

        const price =
            parseInt(
                priceElement.textContent.replace(/,/g,"")
            );

        if(coins < price){

            button.textContent =
                "Not Enough Coins";

            setTimeout(() => {

                button.textContent =
                    "Claim Reward";

            },1500);

            return;
        }


        coins -= price;

        updateCoins();

        button.textContent =
            "✓ Reward Claimed";

        button.style.background =
            "linear-gradient(100deg,#00b87a,#00d9ff)";


        setTimeout(() => {

            button.textContent =
                "Claim Reward";

            button.style.background = "";

        },2000);

    });

});


